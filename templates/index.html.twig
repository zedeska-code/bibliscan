{% extends 'base.html.twig' %}

{% block body %}
<section class="flex flex-col">

<article>
    {{form_start(form)}}
    {{form_row(form.title)}}
    {{form_row(form.author)}}
    {{form_widget(form.submit)}}
    {{form_end(form)}}
</article>

<article>
<table>
    <thead>
<tr>
    <th>Couverture</th>
    <th>Titre</th>
    <th>Auteur</td>
    <th>Genre</td>
    <th>Statut</td>
</tr>
    </thead>
    <tbody>
{% for b in books %}
<tr class="border hover:bg-purple-300">
    <td>
        <a href="{{ path('book_details', { isbn: b.isbn} ) }}">
            <img src={{b.coverUrl}} alt={{b.title}}>
        </a>
    </td>
    <td>
        <a href="{{ path('book_details', { isbn: b.isbn} ) }}">
            {{b.title}}
        </a>
    </td>
    <td>
        <a href="{{ path('book_details', { isbn: b.isbn} ) }}">
            {{b.author}}
        </a>
    </td>
    <td>
        <a href="{{ path('book_details', { isbn: b.isbn} ) }}">
            {{b.genre}}
        </a>
    </td>
    <td>
        <a href="{{ path('book_details', { isbn: b.isbn} ) }}">
            {{b.status}}
        </a>
    </td>
</tr>
{% endfor %}
    </tbody>
</table></article>

<a href={{ path('book_search')}} class="p-4 m-4 border w-fit">Ajouter un livre</a>

</section>
{% endblock %}
