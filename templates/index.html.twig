{% extends 'base.html.twig' %}

{% block body %}
<section class="flex flex-col p-6 m-auto gap-20 lg:max-w-400 rounded-2xl">

    {{form_start(form)}}
<article class="flex items-center justify-start gap-4">
    <div class="rounded-full bg-white p-2 shadow-sm shadow-gray-400">
        {{form_widget(form.title, {
                attr: {placeholder: "Titre"}
            })
        }}
    </div>
    <div class="rounded-full bg-white p-2 shadow-sm shadow-gray-400">;
        {{form_widget(form.author, {
            attr: {placeholder: "Auteur.ice"}
            })
        }}
    </div>
    <div class="rounded-full bg-bg p-2 shadow-sm shadow-gray-400 hover:brightness-110 cursor-pointer">
        {{form_widget(form.submit)}}
    </div>
</article>
    {{form_end(form)}}

<div class="grid grid-cols-6 auto-rows-fr ">
{% for b in books %}
    <a class="card m-2 p-5 bg-primary hover:bg-accent rounded-2xl flex flex-col gap-4 shadow-xl shadow-emerald-600" href="{{ path('book_details', { isbn: b.isbn} ) }}">
        <article class="shadow w-fit">
            <img class="h-50" src={{b.coverUrl}} alt={{b.title}}>
        </article>
        <article>
            <h2 class="text-xl">{{b.title}}</h2>
            <div class="font-light italic">{{b.author}}</div>
            <div class="flex gap-3">
                <h3 class="font-normal">
                    Genre</h3><p class="font-light">{{b.genre}}</p></div>
            <div class="flex gap-3"><h3 class="font-normal">Statut</h3><p class="font-light">{{b.status}}</p></div>
        </article>
          </a>
{% endfor %}
</div>

<a href={{ path('book_search')}} class="p-4 m-4 bg-accent  w-fit rounded-full shadow-sm hover:brightness-125">Ajouter un livre</a>

</section>
{% endblock %}
