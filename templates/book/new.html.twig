{% extends 'base.html.twig' %}
{% block body %}
<section class="m-auto h-dvh flex items-center justify-center">
{{form_start(form)}}

<div>
{{form_label(form.isbn)}}
{{form_widget(form.isbn)}}
{{form_errors(form.isbn)}}
</div>

<div>
{{form_label(form.title)}}
{{form_widget(form.title)}}
{{form_errors(form.title)}}
</div>

<div>
{{form_label(form.author)}}
{{form_widget(form.author)}}
{{form_errors(form.author)}}
</div>

<div>
{{form_label(form.coverUrl)}}
{{form_widget(form.coverUrl)}}
{{form_errors(form.coverUrl)}}
</div>

<div>
{{form_label(form.publisher)}}
{{form_widget(form.publisher)}}
{{form_errors(form.publisher)}}
</div>


<div>
{{form_label(form.publicationDate)}}
{{form_widget(form.publicationDate)}}
{{form_errors(form.publicationDate)}}
</div>

<div>
{{form_label(form.genre)}}
{{form_widget(form.genre)}}
{{form_errors(form.genre)}}
</div>

<div>
{{form_label(form.status)}}
{{form_widget(form.status)}}
{{form_errors(form.status)}}
</div>

<div>
{{form_label(form.rating)}}
{{form_widget(form.rating)}}
{{form_errors(form.rating)}}
</div>

{{form_widget(form.submit)}}

{{form_rest(form) }}

{{form_end(form)}}
</section>

{% endblock %}


