{% extends 'base.html.twig' %}


{% block body %}

<section>
<article>
<h2>{{book.title}}</h2>
<h3>{{book.author}}</h3>
</article>

<article>
    <img src={{book.coverUrl}} alt={{book.title}}>
</article>

<article>
<table>
        <tr>
            <th>
                Éditeur
            </th>
            <td>
                {{book.publisher}}
            </td>
        </tr>
        <tr>
            <th>
                Date de publication
            </th>
            <td>
                {{book.publicationDate | date('d-m-Y')}}
            </td>
        </tr>
        <tr>
            <th>
                ISBN
            </th>
            <td>
                {{book.isbn}}
            </td>
        </tr>
        {{form_start(form)}}
        <tr>
            <th>
                Genre
            </th>
            <td>
            {{form_widget(form.genre)}}
            </td>
        </tr>
        <tr>
            <th>
                Satut
            </th>
            <td>
            {{form_widget(form.status)}}
            </td>
        </tr>
        <tr>
            <th>
                Note
            </th>
            <td>
                {{form_widget(form.rating)}}
            </td>
        </tr>
   </tr>
</table>

    <div class="m-auto p-2 border w-fit">
        {{ form_row(form.submit, {label: 'Enregistrer les modifications'}) }}
    </div>


{{form_row(form.title, {
    attr:{hidden: 'true'},
    label_attr:{hidden: 'true'}
    })
}}
{{form_row(form.isbn, {
    attr:{hidden: 'true'},
    label_attr:{hidden: 'true'}
    })
}}
{{form_row(form.author, {
    attr:{hidden: 'true'},
    label_attr:{hidden: 'true'}
    })
}}
{{form_row(form.coverUrl, {
    attr:{hidden: 'true'},
    label_attr:{hidden: 'true'}
    })
}}
{{form_row(form.publisher, {
    attr:{hidden: 'true'},
    label_attr:{hidden: 'true'}
    })
}}
{{form_row(form.publicationDate, {
    attr:{hidden: 'true'},
    label_attr:{hidden: 'true'}
    })
}}

{{form_rest(form)}}
{{form_end(form)}}

    <form
        method="post"
        action="{{ path('book_delete', {isbn: book.isbn})}}"
        onsubmit="return confirm('Voulez-vous vraiment supprimer ce produit ?');"
        class="m-auto p-2 border w-fit text-shadow-red-700 border-red-700">

        <input type="hidden" name="_token" value=" {{ csrf_token('delete' ~ book.isbn) }}">
        <button type="submit">Supprimer</button>
    </form>
</article>
</section>

{% endblock %}
